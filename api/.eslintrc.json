{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": { "ecmaVersion": 2022 },
  "rules": {
    "no-unused-vars": "error",
    "no-console":    "warn",
    "eqeqeq":        ["error", "always"],
    "no-process-exit": "error",
    "require-await": "error"
  }
}